{
  "name": "myhours",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A mobile-first, offline-ready PWA for multiple jobs, manual shifts and clear pay totals.",
  "author": "Md Sohel Habib (https://www.instagram.com/sohel_habib/)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:pdf": "node --experimental-strip-types tests/render-pdf.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "lucide-react": "1.31.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vite-plugin-pwa": "2.0.0"
  }
}
